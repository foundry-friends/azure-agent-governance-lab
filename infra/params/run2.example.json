{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_comment": "要確認：自前ラッパ向け。BYO は data outputs を 41 に渡します。IP 配列は .env と一致させます。S5 後追い・S6 接続・S7 経路・S8 定義・GA 適合性が未解決。監視/Policy の false は保留であり目標達成ではありません。",
    "reviewRequired": true
  },
  "parameters": {
    "location": {
      "value": "japaneast"
    },
    "prefix": {
      "value": "lab"
    },
    "aiServices": {
      "value": "lab"
    },
    "firstProjectName": {
      "value": "project"
    },
    "projectDescription": {
      "value": "エージェント統制の個人検証"
    },
    "displayName": {
      "value": "エージェント統制検証"
    },
    "modelName": {
      "value": "gpt-5-mini"
    },
    "modelFormat": {
      "value": "OpenAI"
    },
    "modelVersion": {
      "value": "<model-version>"
    },
    "modelSkuName": {
      "value": "GlobalStandard"
    },
    "modelCapacity": {
      "value": 1
    },
    "projectCapHost": {
      "value": "caphostproj"
    },
    "accountCapHost": {
      "value": "caphostacc"
    },
    "deployApplicationInsights": {
      "value": false
    },
    "deploymentTimestamp": {
      "value": "20260915000000"
    },
    "allowedIpRanges": {
      "value": [
        "<corporate-public-ipv4-cidr>"
      ]
    },
    "allowedIpAddressRanges": {
      "value": [
        {
          "from": "<first-ipv4-address>",
          "to": "<last-ipv4-address>"
        }
      ]
    },
    "enableApim": {
      "value": true
    },
    "enableDiagnostics": {
      "value": false
    },
    "enablePolicyDefender": {
      "value": false
    },
    "policyEffect": {
      "value": "Deny"
    },
    "tags": {
      "value": {
        "purpose": "agent-governance-lab",
        "run": "2",
        "deleteAfter": "<deletion-date>"
      }
    },
    "publisherEmail": {
      "value": "<publisher-email>"
    },
    "publisherName": {
      "value": "<publisher-display-name>"
    }
  }
}
