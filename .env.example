# プレースホルダーは引用符を保ったまま、自分の環境で置き換えます。
# このファイルは shell 構文です。信頼できる内容だけを .env に書いてください。
AZURE_SUBSCRIPTION_ID='<subscription-id>'
AZURE_TENANT_ID='<tenant-id>'
AZURE_RESOURCE_GROUP='<resource-group-name>'
AZURE_LOCATION='japaneast'
AZURE_DEPLOYMENT_NAME='<deployment-name>'
FOUNDRY_SAMPLES_COMMIT='58e4127567f7e9afcf0145d874df890284ca5faf'
# deploy.sh --run N は infra/params/runN.local.json を選びます。
# main.bicep、SKU、認証、出力、固定コミットを照合してから true にします。
RUN1_PARAMETERS_REVIEWED=false
RUN2_PARAMETERS_REVIEWED=false
# 展開後にポータルで調べます。API キーや接続文字列は記載しません。
FOUNDRY_ACCOUNT_RESOURCE_ID='<foundry-account-resource-id>'
LOG_ANALYTICS_RESOURCE_ID='<log-analytics-workspace-resource-id>'
# 削除待機上限（30 秒 × 60 回）。課金停止の保証ではありません。
TEARDOWN_MAX_POLLS=60

# 社内の公開 IPv4 CIDR を JSON 配列にします。空配列・全許可は不可です。
ALLOWED_IP_RANGES='["<corporate-public-ipv4-cidr>"]'
# S4 の展開後に照合します。キーではなく ARM ID です。
AI_SEARCH_RESOURCE_ID='<search-resource-id>'
AZURE_STORAGE_ACCOUNT_RESOURCE_ID='<storage-resource-id>'
AZURE_COSMOS_DB_ACCOUNT_RESOURCE_ID='<cosmos-resource-id>'
